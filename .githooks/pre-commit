#!/usr/bin/env bash
# Runs the chalk-book checks before every commit. Turn it on once per clone:
#   git config core.hooksPath .githooks
# Skip it for one commit only with: git commit --no-verify
set -euo pipefail
root=$(git rev-parse --show-toplevel)

"$root/.claude/skills/memory-dump/check.sh"

# check.sh rebuilds the search index; if that changed it, the staged copy was out of date
if ! git -C "$root" diff --quiet -- site/search-index.js; then
  echo "✗ site/search-index.js was out of date and has been rebuilt: stage it (git add site/search-index.js), then commit again"
  exit 1
fi
